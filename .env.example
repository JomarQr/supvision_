# Copy this file to .env.local and fill in real values
# Never commit .env or .env.local to git

# SendGrid API key — get from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# Optional comma-separated origin allowlist for the contact API
# Example: https://supvision.ai,https://www.supvision.ai
ALLOWED_ORIGINS=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAAAAAAAAAAAAAAA

# Upstash Redis for storage-backed rate limiting
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
